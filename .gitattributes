# Keep every textual project artifact stable across developer machines.
* text=auto eol=lf

scripts/soak-report.sh text eol=lf
scripts/diagnostic-soak-1000.sh text eol=lf
# Knowledge-pack bytes are hashed as their canonical LF representation.
data/** text eol=lf

# Precomputed morphology blob is raw bincode, not text: disable CRLF/lf
# normalization or autocrlf corrupts its byte-for-byte hash contract used by
# test_embedded_runtime_blob_is_valid. This overrides the data/** text rule.
data/*.bin binary

# Embedded digest-pinned assets must stay byte-identical on checkout.
qxfx0-semantic/assets/*.json text eol=lf

# The V2 valency fingerprint hashes these bytes; a CRLF checkout would
# desync the audited corpus manifest.
qxfx0-plan-v2/assets/* text eol=lf
