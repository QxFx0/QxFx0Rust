[Unit]
Description=QxFx0 health and latency monitor
After=local-fs.target

[Service]
Type=oneshot
User=qxfx0
Group=qxfx0
EnvironmentFile=-/etc/qxfx0/qxfx0.env
ExecStart=/bin/sh /opt/qxfx0/ops/qxfx0-monitor.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/qxfx0
